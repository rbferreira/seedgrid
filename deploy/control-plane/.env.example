# SeedGrid Control Plane — environment variables.
#
# You don't need to copy or edit this file to get started: the
# scripts/bootstrap-controller.sh creates the .env from it and, on a fresh install,
# GENERATES secrets that are empty or have the example value ("change-...").
# Copy to .env before running only if you want to choose the values.

# Database
POSTGRES_DB=seedgrid
POSTGRES_USER=seedgrid
POSTGRES_PASSWORD=change-this-password

# Application
SEEDGRID_LOG_LEVEL=info

# Token used by Agents during initial registration (public registration endpoint).
# Generated by bootstrap; to choose your own: openssl rand -hex 32
SEEDGRID_AGENT_REGISTRATION_TOKEN=change-this-token

# Initial administrator operator (created on first boot if it doesn't exist).
# With admin/admin, the Portal shows a warning and the login returns default_credentials=true;
# change the password at /profile (POST /api/v1/auth/password) after the first login.
SEEDGRID_ADMIN_USERNAME=admin
SEEDGRID_ADMIN_PASSWORD=change-this-admin-password

# Behavior tunables (ADR-023): now managed by the Settings panel of the
# Portal, with hot-reload (take effect without redeploy). The envs below only SEED the DB on the 1st
# boot (when there is no recorded value yet); after that, the panel is the source of truth
# and changing the .env has no effect anymore. Optional — all have defaults in the code catalog.
#SEEDGRID_ALERT_WORKER_INTERVAL=30s     # alert evaluation frequency
#SEEDGRID_NODE_OFFLINE_AFTER=90s        # heartbeat expired beyond this => Node OFFLINE
#SEEDGRID_DISK_IO_SATURATED_PCT=90      # disk util% >= this (sustained) => DISK_IO_SATURATED alert
#SEEDGRID_SAMPLE_RETENTION=168h         # history retention per torrent (7 days)
#SEEDGRID_PROMETHEUS_URL=http://seedgrid-prometheus:9090
#SEEDGRID_TMDB_API_KEY=                  # TMDB v3 key (ADR-020); enables tmdb/imdb/tvdb on UNIT3D publishing
# Download admission controller (ADR-021): keeps <= L torrents downloading in the cluster.
#SEEDGRID_ADMISSION_INTERVAL=20s         # admission controller evaluation frequency
#SEEDGRID_MAX_CLUSTER_DOWNLOADS=0        # fallback L when the tracker hasn't reported the limit yet; 0 = no fallback (only acts with observed L)
#SEEDGRID_DL_SLOT_LIMIT_TTL=6h           # validity of the observed L in the tracker msg before falling back
# Healthy rate rotation (#22): a download at the cap below MIN_DL_RATE (bytes/s)
# for continuous SLOW_GRACE yields the slot to another in the queue; the rotated one stays SLOW_COOLDOWN
# out of the promotion queue (anti-thrashing). MIN_DL_RATE=0 disables rotation.
#SEEDGRID_ADMISSION_MIN_DL_RATE=51200    # 50 KiB/s
#SEEDGRID_ADMISSION_SLOW_GRACE=5m
#SEEDGRID_ADMISSION_SLOW_COOLDOWN=10m
# Peer-aware eligibility + DEAD torrent rotation (ADR-021 evolution): promotion
# prioritizes those with seeds/peers (then higher %); an active one with 0 seeds AND 0 peers for
# continuous DEAD_GRACE yields the slot immediately and goes to the end of the queue for DEAD_COOLDOWN
# (doesn't return even if it has the highest %). DEAD_GRACE=0 disables dead rotation.
#SEEDGRID_ADMISSION_DEAD_GRACE=3m
#SEEDGRID_ADMISSION_DEAD_COOLDOWN=30m

# Internal webhooks token (/integrations/*, #116). Generated automatically by
# scripts/bootstrap-controller.sh on the first run (shared with Alertmanager). Empty =
# open webhooks (compat) with a warning in the log.
SEEDGRID_INTEGRATION_TOKEN=
