# SeedGrid Agent — environment variables (reference to /etc/seedgrid-agent.env).
# In normal onboarding you don't copy this file: bootstrap-node.sh generates the Node env.
#
# This file only holds IDENTITY and MACHINE: how this Node connects to the Control Plane and
# Engine, and where data is stored. The BEHAVIOR of the Agent and Engine (intervals, log level,
# download queue) is NOT configured here: it comes from the Control Plane (ADR-039) — cluster value in
# Portal → Settings → Agent / Engine, and, for a machine that needs a different value, a
# custom value on the Node page. See the "Behavior" section at the end of this file.

# Control Plane URL — via the Portal's nginx (port 80), NOT the backend's 8080.
# 8080 only listens on 127.0.0.1 on the CP machine (M2/#11): it's unreachable from the network.
SEEDGRID_CONTROL_PLANE_URL=http://controller.example

# Registration token (same value as the Control Plane's SEEDGRID_AGENT_REGISTRATION_TOKEN).
# Only required on first registration; afterwards the identity is stored in StateDirectory.
SEEDGRID_AGENT_REGISTRATION_TOKEN=change-this-token

# Torrent Engine (qBittorrent WebUI)
SEEDGRID_ENGINE_QBT_URL=http://127.0.0.1:8080
SEEDGRID_ENGINE_QBT_USERNAME=admin
SEEDGRID_ENGINE_QBT_PASSWORD=change-this-password

# BitTorrent port for this Node — UNIQUE per Node in your cluster (e.g., node-01=6881,
# node-02=6882, ...). The Agent sets qBittorrent's listen_port to this value and
# reports it to the Control Plane (shows up in the Portal as "BT Endpoint"). Must match
# SEEDGRID_ENGINE_BT_PORT in deploy/agent/.env (container mapping) and the
# port forward YOU create in the firewall (WAN <port> → <node-ip>:<port>).
SEEDGRID_ENGINE_BT_PORT=6881

# Migration transfer server port (ADR-018). The Agent listens on it
# (on the host) to serve/pull torrent content during a migration between
# Nodes, under a one-time token issued by the Control Plane. Same port on all
# Nodes (default 6900). Nodes on the same LAN reach each other directly; if the SOURCE is
# behind NAT, create a port forward WAN 6900 → <node-ip>:6900 on it.
SEEDGRID_AGENT_MIGRATION_PORT=6900

# Optional (with defaults) — identity/machine
SEEDGRID_AGENT_ENGINE=qbittorrent
# Torrent Engine container name (only to report its uptime in the heartbeat).
# Must be the `container_name` from this Node's compose — the repo uses
# seedgrid-engine, which is also the Agent's default. Only uncomment on a Node whose
# container still has a different name.
#SEEDGRID_ENGINE_CONTAINER=seedgrid-engine
SEEDGRID_AGENT_DATA_DIR=/var/lib/seedgrid-agent
SEEDGRID_AGENT_STORAGE_PATH=/data
# Does this Node have a DEDICATED DISK at /data? Operator declaration, recorded during installation by
# bootstrap-node.sh — the Agent never infers it (an unmounted disk looks like a local folder).
#   true  /data is only healthy if it's a mountpoint AND writable. Protects against the disk that didn't
#         mount: without this the Engine would write to the system disk and the Node would look healthy.
#   false /data is a folder on the system disk (VM, mini PC, single-disk NAS): only writing is
#         checked; free space remains monitored by the NODE_DISK_FULL alert.
# Absent = true (the safe side, and what every Node before this variable always had). On a single-disk
# Node, without this line set to false, the Node is excluded from the Scheduler forever
# (storage_ok=false, "not a mountpoint"). To change after installation: edit and restart the Agent;
# to gain a dedicated disk, `sh bootstrap-node.sh --storage-only` already records true.
# docs/06 - Storage.md §35.3.
SEEDGRID_AGENT_STORAGE_REQUIRE_MOUNT=true

# ─────────────────────────────────────────────────────────────────────────────────────────
# Behavior — comes from the Control Plane (ADR-039). DO NOT uncomment as a routine.
#
# The variables below are only the Agent's FALLBACK: they apply when the Control Plane sends nothing
# (CP older than ADR-039, CP offline, or the Agent booting before the first heartbeat). With the
# Control Plane online, the effective value is: this Node's override > cluster value > these
# variables > code default. That's why they are COMMENTED OUT: a new Node must be born identical
# to the cluster — the bug that #144 fixes is exactly every machine carrying its own number.
#
# ⚠️ If you DEFINE one of them on a Node that already existed, the Control Plane treats it as your decision:
# on the new Agent's first heartbeat it reports it and, if it differs from the cluster value, becomes an
# override for this Node (only once — see docs/19 - Deployment.md §50.5). To give a machine a
# custom value AFTER that, use the Portal (Node page → this Node's Configuration), not this
# file: editing it now changes nothing, precedence is override > cluster > env.
#
# CODE defaults (what applies without Control Plane and without the variable):
#SEEDGRID_AGENT_HEARTBEAT_INTERVAL=30s
#SEEDGRID_AGENT_COMMAND_POLL_INTERVAL=5s
#SEEDGRID_LOG_LEVEL=info
#
# Torrent Engine queue (protection against I/O saturation). Without a queue, adding many torrents
# at once triggers all downloads together → 100% I/O, high load, torrents stuck in
# checkingResumeData and, on USB HDDs, disk dropouts due to underpowering.
#SEEDGRID_ENGINE_QUEUEING_ENABLED=true
# Active downloads cap PER Node, modest in the code (belt and suspenders). What guarantees the limit
# of DL slots per tracker account across the ENTIRE cluster is the Control Plane's admission controller
# (#21). It's the parameter that differs most between machines (an Atom handles 3, an i5 handles 10): if a
# machine needs a lower value, create a custom value for it in the Portal.
#SEEDGRID_ENGINE_MAX_ACTIVE_DOWNLOADS=2
# Practically unlimited on purpose: a queued seeder sends event=stopped to the tracker and gets
# Hit and Run. Only downloads and checks should be queued.
#SEEDGRID_ENGINE_MAX_ACTIVE_UPLOADS=10000
#SEEDGRID_ENGINE_MAX_ACTIVE_TORRENTS=10000
#SEEDGRID_ENGINE_MAX_ACTIVE_CHECKING=1
# dont_count_slow_torrents=false on purpose: with true, a stalled download (0 KB/s waiting for
# peer slot on the tracker) DOES NOT count towards the cap above, so qBt activates ALL downloads → all
# announce → tracker refuses slots (thundering herd) → general stall. With false the cap holds and the
# excess stays in queuedDL.
#SEEDGRID_ENGINE_DONT_COUNT_SLOW=false
#SEEDGRID_ENGINE_SLOW_DL_THRESHOLD=1
#SEEDGRID_ENGINE_SLOW_UL_THRESHOLD=1
#SEEDGRID_ENGINE_SLOW_INACTIVE_TIMER=300
