# SeedGrid Agent — variables read by docker compose in this directory
# (${...} interpolation in docker-compose.yml). Copy to .env and adjust.
#
# WARNING: this .env is for COMPOSE (port mapping for the qBittorrent container).
# The Agent binary configuration (systemd) is in /etc/seedgrid-agent.env
# (see seedgrid-agent.env.example). The value of SEEDGRID_ENGINE_BT_PORT must
# be the SAME in both places.

# BitTorrent Port — UNIQUE per Node (the operator forwards WAN -> IP_DO_NODE:port).
# node-01 = 6881, node-02 = 6882, etc. Compose maps TCP and UDP on this port.
SEEDGRID_ENGINE_BT_PORT=6881

# Propagation of the /data bind mount to the Engine container (default: rslave). With rslave,
# a disk mounted at /data on the host AFTER the Engine comes up appears inside the container
# without recreating it. Only change to rprivate if the mount containing /data is `private` —
# Docker refuses to create the container in this case (`findmnt -no PROPAGATION -T /data` shows).
# bootstrap-node.sh already writes this value automatically when it detects this case.
#SEEDGRID_DATA_PROPAGATION=rslave
